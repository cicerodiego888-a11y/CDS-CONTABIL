PORT=3333
JWT_SECRET=troque-esta-chave-por-uma-chave-aleatoria-e-secreta
NODE_ENV=development
CDS_CNPJ_PROVIDER=brasilapi
CDS_CNPJ_API_URL=https://brasilapi.com.br/api/cnpj/v1
# CDS_CNPJ_API_KEY=
CDS_CNPJ_TIMEOUT_MS=8000
CDS_CNPJ_LOOKUP_MAX=20
CDS_WHATSAPP_PROVIDER=meta
CDS_WHATSAPP_API_URL=https://graph.facebook.com/v21.0
# CDS_WHATSAPP_API_TOKEN=
# CDS_WHATSAPP_PHONE_NUMBER_ID=
# CDS_WHATSAPP_VERIFY_TOKEN=
# CDS_WHATSAPP_APP_SECRET=
CDS_WHATSAPP_TIMEOUT_MS=8000
# CDS_EMAIL_SECRET=  # chave de criptografia da credencial SMTP persistida (fallback: JWT_SECRET)
CDS_EMAIL_PROVIDER=off
CDS_EMAIL_HOST=
CDS_EMAIL_PORT=587
CDS_EMAIL_USER=
CDS_EMAIL_PASSWORD=
CDS_EMAIL_FROM=
CDS_EMAIL_FROM_NAME=CDS Contábil
CDS_EMAIL_APP_URL=http://localhost:3333
CDS_EMAIL_TIMEOUT_MS=10000
# Infraestrutura transacional CDS (não é SMTP). Sem URL+chave o provider CDS fica NOT_CONFIGURED.
