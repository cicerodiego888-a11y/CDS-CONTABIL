NODE_ENV=development
PORT=3333
CLIENT_PORT=3334

# Rede — somente para teste local (nunca use lan em produção)
# local = acesso somente neste computador (padrão)
# lan = permite teste por outros computadores da mesma rede (bind 0.0.0.0)
CDS_NETWORK_MODE=local

CDS_DB_PATH=
UPLOAD_DIR=
EXPORT_DIR=

JWT_SECRET=troque-esta-chave-por-uma-chave-aleatoria-e-secreta
DOCUMENT_ENCRYPTION_KEY=
DOCUMENT_ENCRYPTION_KID=v1
DEMO_MODE=false

# Cookie HttpOnly opcional no escritório (recomendado true em produção)
# CDS_AUTH_COOKIE=false
# CDS_CORS_ORIGIN=

# Links de convite/PASSWORD_RESET (/convite/:token). Com dual-port, use a porta do Portal (3334).
CDS_EMAIL_APP_URL=http://localhost:3334
# Link de onboarding do escritório (/ativar-escritorio/:token). Opcional; padrão = http://localhost:$PORT
# CDS_OFFICE_PUBLIC_URL=http://localhost:3333

CDS_EMAIL_PROVIDER=smtp
CDS_EMAIL_HOST=
CDS_EMAIL_PORT=587
CDS_EMAIL_USER=
CDS_EMAIL_PASSWORD=
CDS_EMAIL_FROM=
CDS_EMAIL_FROM_NAME=CDS Contábil
# CDS_EMAIL_API_URL=
# CDS_EMAIL_API_KEY=
# CDS_EMAIL_SECRET=

CDS_CNPJ_PROVIDER=brasilapi
CDS_CNPJ_API_URL=https://brasilapi.com.br/api/cnpj/v1
CDS_CNPJ_TIMEOUT_MS=8000
CDS_CNPJ_LOOKUP_MAX=20

CDS_WHATSAPP_PROVIDER=meta
CDS_WHATSAPP_API_URL=https://graph.facebook.com/v21.0
CDS_WHATSAPP_TIMEOUT_MS=8000

CDS_PROCESS_SCHEDULER=on
CDS_PROCESS_SCHEDULER_MS=300000

# IA / visão (PNG/JPG) — OPENAI_API_KEY ou credencial no Cofre via UI
AI_PROVIDER=off
AI_ENABLED=false
OPENAI_API_KEY=
AI_MODEL=gpt-5.6-terra
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=30000
AI_CREDENTIAL_ENCRYPTION_KEY=
AI_DEBUG=false

# Web Push (VAPID) — gere com: npx web-push generate-vapid-keys
# NUNCA commit a chave privada.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:suporte@seuescritorio.local
