NODE_ENV=production
PORT=3333
CLIENT_PORT=0

# Produção: manter local. LAN é bloqueado com NODE_ENV=production.
CDS_NETWORK_MODE=local

CDS_DB_PATH=/opt/cds-contabil/database/cds-contabil-connect.db
UPLOAD_DIR=/opt/cds-contabil/uploads
EXPORT_DIR=/opt/cds-contabil/exports
BACKUP_DIR=/opt/cds-contabil/backups

CDS_OFFICE_PUBLIC_URL=https://SEU-DOMINIO
CDS_CORS_ORIGIN=https://SEU-DOMINIO

CDS_AUTH_COOKIE=true

CDS_EMAIL_PROVIDER=smtp
CDS_EMAIL_HOST=
CDS_EMAIL_PORT=587
CDS_EMAIL_USER=
CDS_EMAIL_PASSWORD=
CDS_EMAIL_FROM=
CDS_EMAIL_FROM_NAME=CDS Contábil

JWT_SECRET=
DOCUMENT_ENCRYPTION_KEY=

DEMO_MODE=false

# Opcional — override de base de links do portal (mesma origem pública se omitido)
# CDS_EMAIL_APP_URL=https://SEU-DOMINIO

# Opcional — IA
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# AI_CREDENTIAL_ENCRYPTION_KEY=

# Opcional — Web Push
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_VAPID_SUBJECT=mailto:suporte@seudominio
